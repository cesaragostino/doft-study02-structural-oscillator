\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Distribution of noise-corrected participation numbers $\ensuremath  {{N_{\mathrm  {corr}}}}= \ensuremath  {{F_{\mathrm  {m}}^{\ast }}}/ \ensuremath  {{f_{\mathrm  {base}}}}$ (``Real'') compared with a null model obtained by shuffling $\ensuremath  {\Theta _{\mathrm  {D}}}$ across materials (``Null''). Vertical dotted lines highlight modes around $N \simeq 1$, $N \simeq 2$ and $N \simeq 24$--$25$. }}{5}{figure.5}\protected@file@percent }
\newlabel{fig:N_hist}{{5}{5}{Distribution of noise-corrected participation numbers $\Ncorr = \Fmstar / \fbase $ (``Real'') compared with a null model obtained by shuffling $\ThetaD $ across materials (``Null''). Vertical dotted lines highlight modes around $N \simeq 1$, $N \simeq 2$ and $N \simeq 24$--$25$}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {C}Structural noise vs integer locking}{5}{section*.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Evidence of quantization.\ The distribution of locking residuals $|\ensuremath  {\delta }| = |\ensuremath  {{N_{\mathrm  {corr}}}}- \mathrm  {round}(\ensuremath  {{N_{\mathrm  {corr}}}})|$ for the real data (blue) shows a sharp excess at $|\ensuremath  {\delta }| \approx 0$ that is absent in the shuffled-$\ensuremath  {\Theta _{\mathrm  {D}}}$ null (orange). Under the null, the probability of obtaining an equal or stronger concentration at zero deviation is $p < 10^{-13}$ (Kolmogorov--Smirnov and Mann--Whitney tests), and Cliff's $\Delta \simeq 0.32$ indicates a medium-to-large effect size. }}{6}{figure.6}\protected@file@percent }
\newlabel{fig:delta_hist}{{6}{6}{Evidence of quantization.\ The distribution of locking residuals $|\deltalock | = |\Ncorr - \mathrm {round}(\Ncorr )|$ for the real data (blue) shows a sharp excess at $|\deltalock | \approx 0$ that is absent in the shuffled-$\ThetaD $ null (orange). Under the null, the probability of obtaining an equal or stronger concentration at zero deviation is $p < 10^{-13}$ (Kolmogorov--Smirnov and Mann--Whitney tests), and Cliff's $\Delta \simeq 0.32$ indicates a medium-to-large effect size}{figure.6}{}}
