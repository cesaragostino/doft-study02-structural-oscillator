\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Per-family distribution of locking residuals $|\ensuremath  {\delta }|$ (clipped at 1.0). Boxes show interquartile ranges and medians; whiskers extend to $1.5$ times the interquartile range. Families are ordered by increasing median residual. }}{7}{figure.7}\protected@file@percent }
\newlabel{fig:delta_by_family}{{7}{7}{Per-family distribution of locking residuals $|\deltalock |$ (clipped at 1.0). Boxes show interquartile ranges and medians; whiskers extend to $1.5$ times the interquartile range. Families are ordered by increasing median residual}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Absolute locking residual $|\ensuremath  {\delta }|$ vs structural-noise $z$--score $\ensuremath  {{z_{\xi }}}$. Colors indicate material families. The Spearman correlation is $\rho \simeq 0.34$ with $p \simeq 5.6 \times 10^{-4}$, indicating that higher structural noise is associated with weaker integer locking. }}{7}{figure.8}\protected@file@percent }
\newlabel{fig:delta_vs_noise}{{8}{7}{Absolute locking residual $|\deltalock |$ vs structural-noise $z$--score $\znoise $. Colors indicate material families. The Spearman correlation is $\rho \simeq 0.34$ with $p \simeq 5.6 \times 10^{-4}$, indicating that higher structural noise is associated with weaker integer locking}{figure.8}{}}
