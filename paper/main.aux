\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Calibrated base frequencies $f_{\mathrm  {base},k}$ (medians per family) ordered from left to right. The dashed line marks the global median $\tilde  {f}_{\mathrm  {base}} \simeq 4.16$. Superfluid helium calibrates near $f_{\mathrm  {base},\mathrm  {He}} \simeq 4.0$; several superconducting families cluster around the same scale, while oxides and heavy fermions sit near $\sim 2.3$ and iron--based materials near unity. These bands are consistent with an approximate 1--2--4 ladder of preferred base frequencies, though the structure is phenomenological and not exact. }}{6}{figure.4}\protected@file@percent }
\newlabel{fig:fbase_by_family}{{4}{6}{Calibrated base frequencies $\fbasefam {k}$ (medians per family) ordered from left to right. The dashed line marks the global median $\tilde {f}_{\mathrm {base}} \simeq 4.16$. Superfluid helium calibrates near $\fbasefam {\mathrm {He}} \simeq 4.0$; several superconducting families cluster around the same scale, while oxides and heavy fermions sit near $\sim 2.3$ and iron--based materials near unity. These bands are consistent with an approximate 1--2--4 ladder of preferred base frequencies, though the structure is phenomenological and not exact}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Locking error $|\delta |$ vs.\ family--normalized structural noise $Z_{\xi }$, with points coloured by superconducting family. The annotation reports the Spearman rank correlation between the two quantities. Families with larger normalized noise tend to exhibit weaker integer participation. }}{6}{figure.5}\protected@file@percent }
\newlabel{fig:delta_vs_noise}{{5}{6}{Locking error $|\deltalock |$ vs.\ family--normalized structural noise $\znoise $, with points coloured by superconducting family. The annotation reports the Spearman rank correlation between the two quantities. Families with larger normalized noise tend to exhibit weaker integer participation}{figure.5}{}}
