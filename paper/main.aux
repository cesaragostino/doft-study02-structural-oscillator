\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Structural-noise $z$--score $\ensuremath  {{z_{\xi }}}$ for materials in the ``almost-integer'' group (top 20\% smallest $|\ensuremath  {\delta }|$) and for the rest of the dataset. The almost-integer group is shifted toward lower noise, with Cliff's $\Delta \simeq -0.47$. }}{5}{figure.6}\protected@file@percent }
\newlabel{fig:noise_almost_integer}{{6}{5}{Structural-noise $z$--score $\znoise $ for materials in the ``almost-integer'' group (top 20\% smallest $|\deltalock |$) and for the rest of the dataset. The almost-integer group is shifted toward lower noise, with Cliff's $\Delta \simeq -0.47$}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Harmonic Spectrum. Calibrated base frequencies ($f_{base}$) for each family. The sequence reveals a harmonic structure: Iron-based compounds resonate at the fundamental mode ($f_{base} \approx 1$), while simple metals and hydrides lock into higher harmonics ($f_{base} \approx 4-5$). }}{6}{figure.7}\protected@file@percent }
\newlabel{fig:fbase_by_family}{{7}{6}{Harmonic Spectrum. Calibrated base frequencies ($f_{base}$) for each family. The sequence reveals a harmonic structure: Iron-based compounds resonate at the fundamental mode ($f_{base} \approx 1$), while simple metals and hydrides lock into higher harmonics ($f_{base} \approx 4-5$)}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Geometric manifestation of integer participation.} Participation number $N = F_m^* / f_{\mathrm  {base}}$ vs.\ experimental coherence length $\xi _0$ for 11 representative superconductors. The dashed line shows a power-law fit $N \sim \xi _0^{0.43}$ ($R^2 = 0.455$), spanning nearly four orders of magnitude. Materials with $N \approx 1$ (e.g., FeSe) exhibit ultra-short coherence lengths (maximal confinement), while large-$N$ systems (e.g., Al) correspond to extended, diffusive coherence volumes. The correlation holds across all families (Type~I/II, binaries, iron-based, high-pressure hydrides), indicating that $N$ encodes a universal geometric property of the superconducting state. Coherence lengths are taken from experimental measurements where available (tunneling, $\mu $SR, $H_{c2}$) and supplemented by BCS estimates for classical metals (see text for details). }}{7}{figure.8}\protected@file@percent }
\newlabel{fig:N_vs_xi0}{{8}{7}{\textbf {Geometric manifestation of integer participation.} Participation number $N = F_m^* / f_{\mathrm {base}}$ vs.\ experimental coherence length $\xi _0$ for 11 representative superconductors. The dashed line shows a power-law fit $N \sim \xi _0^{0.43}$ ($R^2 = 0.455$), spanning nearly four orders of magnitude. Materials with $N \approx 1$ (e.g., FeSe) exhibit ultra-short coherence lengths (maximal confinement), while large-$N$ systems (e.g., Al) correspond to extended, diffusive coherence volumes. The correlation holds across all families (Type~I/II, binaries, iron-based, high-pressure hydrides), indicating that $N$ encodes a universal geometric property of the superconducting state. Coherence lengths are taken from experimental measurements where available (tunneling, $\mu $SR, $H_{c2}$) and supplemented by BCS estimates for classical metals (see text for details)}{figure.8}{}}
\newlabel{eq:N_xi0_scaling}{{9}{7}{}{equation.9}{}}
