\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Structural noise $Z_{\xi }$ for two groups: materials in the lowest 20\% of locking error (``almost integer'') and the rest of the dataset. The almost--integer group resides in systematically quieter structural environments; Cliff's $\Delta \simeq -0.47$ quantifies the effect size. }}{7}{figure.6}\protected@file@percent }
\newlabel{fig:noise_groups}{{6}{7}{Structural noise $\znoise $ for two groups: materials in the lowest 20\% of locking error (``almost integer'') and the rest of the dataset. The almost--integer group resides in systematically quieter structural environments; Cliff's $\Delta \simeq -0.47$ quantifies the effect size}{figure.6}{}}
