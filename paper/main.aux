\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Evidence of quantization.\ The distribution of locking residuals $|\ensuremath  {\delta }| = |\ensuremath  {{N_{\mathrm  {corr}}}}- \mathrm  {round}(\ensuremath  {{N_{\mathrm  {corr}}}})|$ for the real data (blue) shows a sharp excess at $|\ensuremath  {\delta }| \approx 0$ that is absent in the shuffled-$\ensuremath  {\Theta _{\mathrm  {D}}}$ null (orange). Under the null, the probability of obtaining an equal or stronger concentration at zero deviation is $p < 10^{-13}$ (Kolmogorov--Smirnov and Mann--Whitney tests), and Cliff's $\Delta \simeq 0.32$ indicates a medium-to-large effect size. }}{3}{figure.2}\protected@file@percent }
\newlabel{fig:delta_hist}{{2}{3}{Evidence of quantization.\ The distribution of locking residuals $|\deltalock | = |\Ncorr - \mathrm {round}(\Ncorr )|$ for the real data (blue) shows a sharp excess at $|\deltalock | \approx 0$ that is absent in the shuffled-$\ThetaD $ null (orange). Under the null, the probability of obtaining an equal or stronger concentration at zero deviation is $p < 10^{-13}$ (Kolmogorov--Smirnov and Mann--Whitney tests), and Cliff's $\Delta \simeq 0.32$ indicates a medium-to-large effect size}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {D}Base-frequency hierarchy across families}{3}{section*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-family distribution of locking residuals $|\ensuremath  {\delta }|$ (clipped at 1.0). Boxes show interquartile ranges and medians; whiskers extend to $1.5$ times the interquartile range. Families are ordered by increasing median residual. }}{4}{figure.3}\protected@file@percent }
\newlabel{fig:delta_by_family}{{3}{4}{Per-family distribution of locking residuals $|\deltalock |$ (clipped at 1.0). Boxes show interquartile ranges and medians; whiskers extend to $1.5$ times the interquartile range. Families are ordered by increasing median residual}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Absolute locking residual $|\ensuremath  {\delta }|$ vs structural-noise $z$--score $\ensuremath  {{z_{\xi }}}$. Colors indicate material families. The Spearman correlation is $\rho \simeq 0.34$ with $p \simeq 5.6 \times 10^{-4}$, indicating that higher structural noise is associated with weaker integer locking. }}{4}{figure.4}\protected@file@percent }
\newlabel{fig:delta_vs_noise}{{4}{4}{Absolute locking residual $|\deltalock |$ vs structural-noise $z$--score $\znoise $. Colors indicate material families. The Spearman correlation is $\rho \simeq 0.34$ with $p \simeq 5.6 \times 10^{-4}$, indicating that higher structural noise is associated with weaker integer locking}{figure.4}{}}
