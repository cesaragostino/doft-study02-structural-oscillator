\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Topology by Family. Distribution of the deviation $|\delta |$ across different superconductor families. Iron-based superconductors (left) exhibit the tightest integer locking (median $|\delta | \approx 0.05$), behaving as near-ideal oscillators, whereas high-pressure hydrides show larger dispersion due to structural stress. }}{5}{figure.4}\protected@file@percent }
\newlabel{fig:delta_by_family}{{4}{5}{Topology by Family. Distribution of the deviation $|\delta |$ across different superconductor families. Iron-based superconductors (left) exhibit the tightest integer locking (median $|\delta | \approx 0.05$), behaving as near-ideal oscillators, whereas high-pressure hydrides show larger dispersion due to structural stress}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Stability Mechanism. (a) Correlation between distance to integer and structural noise. (b) Materials satisfying the integer condition ($|\delta |$ in lowest 20\%) show significantly lower structural noise (Cliff's $\delta \approx -0.47$). This suggests that integer resonance acts as a protective mechanism for coherence. }}{5}{figure.5}\protected@file@percent }
\newlabel{fig:delta_vs_noise}{{5}{5}{Stability Mechanism. (a) Correlation between distance to integer and structural noise. (b) Materials satisfying the integer condition ($|\delta |$ in lowest 20\%) show significantly lower structural noise (Cliff's $\delta \approx -0.47$). This suggests that integer resonance acts as a protective mechanism for coherence}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Structural-noise $z$--score $\ensuremath  {{z_{\xi }}}$ for materials in the ``almost-integer'' group (top 20\% smallest $|\ensuremath  {\delta }|$) and for the rest of the dataset. The almost-integer group is shifted toward lower noise, with Cliff's $\Delta \simeq -0.47$. }}{5}{figure.6}\protected@file@percent }
\newlabel{fig:noise_almost_integer}{{6}{5}{Structural-noise $z$--score $\znoise $ for materials in the ``almost-integer'' group (top 20\% smallest $|\deltalock |$) and for the rest of the dataset. The almost-integer group is shifted toward lower noise, with Cliff's $\Delta \simeq -0.47$}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Harmonic Spectrum. Calibrated base frequencies ($f_{base}$) for each family. The sequence reveals a harmonic structure: Iron-based compounds resonate at the fundamental mode ($f_{base} \approx 1$), while simple metals and hydrides lock into higher harmonics ($f_{base} \approx 4-5$). }}{6}{figure.7}\protected@file@percent }
\newlabel{fig:fbase_by_family}{{7}{6}{Harmonic Spectrum. Calibrated base frequencies ($f_{base}$) for each family. The sequence reveals a harmonic structure: Iron-based compounds resonate at the fundamental mode ($f_{base} \approx 1$), while simple metals and hydrides lock into higher harmonics ($f_{base} \approx 4-5$)}{figure.7}{}}
