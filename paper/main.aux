\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Distribution of noise-corrected participation numbers $\ensuremath  {{N_{\mathrm  {corr}}}}= \ensuremath  {{F_{\mathrm  {m}}^{\ast }}}/ \ensuremath  {{f_{\mathrm  {base}}}}$ (``Real'') compared with a null model obtained by shuffling $\ensuremath  {\Theta _{\mathrm  {D}}}$ across materials (``Null''). Vertical dotted lines highlight modes around $N \simeq 1$, $N \simeq 2$ and $N \simeq 24$--$25$. }}{3}{figure.2}\protected@file@percent }
\newlabel{fig:N_hist}{{2}{3}{Distribution of noise-corrected participation numbers $\Ncorr = \Fmstar / \fbase $ (``Real'') compared with a null model obtained by shuffling $\ThetaD $ across materials (``Null''). Vertical dotted lines highlight modes around $N \simeq 1$, $N \simeq 2$ and $N \simeq 24$--$25$}{figure.2}{}}
