\newlabel{fig:noise_almost_integer}{{5}{4}{Structural-noise $z$--score $\znoise $ for materials in the ``almost-integer'' group (top 20\% smallest $|\deltalock |$) and for the rest of the dataset. The almost-integer group is shifted toward lower noise, with Cliff's $\Delta \simeq -0.47$}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Base frequency $\ensuremath  {{f_{\mathrm  {base}}}}$ per family (median over materials), ordered by increasing value. The dashed line marks the global median $\ensuremath  {{f_{\mathrm  {base}}}}_{\mathrm  {med}} \simeq 4.157$. Families cluster around approximately harmonic values $\ensuremath  {{f_{\mathrm  {base}}}}\sim 1$, $2$ and $4$, with iron-based superconductors near the fundamental and binary / molecular / high-pressure materials near the $n=4$ harmonic associated with \ensuremath  {{^{4}\ensuremath  {\mathrm  {He}}}}. }}{5}{figure.6}\protected@file@percent }
\newlabel{fig:fbase_by_family}{{6}{5}{Base frequency $\fbase $ per family (median over materials), ordered by increasing value. The dashed line marks the global median $\fbase _{\mathrm {med}} \simeq 4.157$. Families cluster around approximately harmonic values $\fbase \sim 1$, $2$ and $4$, with iron-based superconductors near the fundamental and binary / molecular / high-pressure materials near the $n=4$ harmonic associated with \HeFour }{figure.6}{}}
